{
  "name": "opencode-agentbus",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "bun@1.3.9",
  "workspaces": ["packages/*"],
  "scripts": {
    "build:protocol": "bun run --cwd packages/protocol build",
    "build:broker": "bun run --cwd packages/broker build",
    "build:plugin": "bun run --cwd packages/plugin build",
    "build": "bun run build:protocol && bun run build:broker && bun run build:plugin",
    "test:unit": "bun test packages scripts",
    "test:integration": "bun test tests/integration",
    "test:all": "bun run test:unit && bun run test:integration",
    "test": "bun run build && bun run test:all",
    "coverage:raw": "bun test packages scripts --coverage",
    "coverage": "bun run build && bun run coverage:raw",
    "typecheck:root": "tsc --noEmit -p tsconfig.scripts.json",
    "typecheck:protocol": "bun run --cwd packages/protocol typecheck",
    "typecheck:broker": "bun run --cwd packages/broker typecheck",
    "typecheck:plugin": "bun run --cwd packages/plugin typecheck",
    "typecheck:integration": "tsc --noEmit -p tsconfig.integration.json",
    "typecheck": "bun run build && bun run typecheck:root && bun run typecheck:protocol && bun run typecheck:broker && bun run typecheck:plugin && bun run typecheck:integration",
    "lint": "biome lint --error-on-warnings .",
    "format-check": "biome format .",
    "broker:start": "bun run --cwd packages/broker start",
    "package-smoke": "bun scripts/package-smoke.ts",
    "audit": "bun audit && bun run audit:static",
    "audit:static": "bun scripts/audit-plugin-source.ts",
    "release:pack": "bun scripts/release/package.ts",
    "release:smoke": "bun scripts/release/smoke.ts",
    "release:check": "bun scripts/release/policy.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/bun": "1.1.14",
    "typescript": "5.7.2"
  }
}

{
  "name": "@opencode-agentbus/plugin",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/v2.d.ts",
      "import": "./dist/v2.js",
      "default": "./dist/v2.js"
    },
    "./v2": {
      "types": "./dist/v2.d.ts",
      "import": "./dist/v2.js",
      "default": "./dist/v2.js"
    },
    "./tui": {
      "types": "./dist/tui-v2.d.ts",
      "import": "./dist/tui-v2.js",
      "default": "./dist/tui-v2.js"
    },
    "./rpc": {
      "types": "./dist/rpc-v2.d.ts",
      "import": "./dist/rpc-v2.js",
      "default": "./dist/rpc-v2.js"
    },
    "./stock-experimental": {
      "types": "./dist/stock-v2.d.ts",
      "import": "./dist/stock-v2.js",
      "default": "./dist/stock-v2.js"
    }
  },
  "files": ["dist", "server.js", "tui.js", "rpc.js"],
  "scripts": {
    "test": "bun test",
    "typecheck": "bun ../../scripts/run-package-tsc.ts typecheck",
    "build": "bun ../../scripts/run-package-tsc.ts build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@opencode-agentbus/broker": "workspace:0.1.0",
    "@opencode-agentbus/protocol": "workspace:0.1.0",
    "@opencode-ai/plugin": "1.18.19",
    "@opencode/plugin": "2.2.7",
    "@opencode/client": "2.2.7",
    "@opencode/schema": "2.2.7",
    "effect": "4.1.0",
    "zod": "3.25.76"
  }
}
